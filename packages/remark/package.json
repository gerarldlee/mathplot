{
  "name": "@mathplot/remark",
  "version": "0.1.0",
  "description": "Remark plugin that turns ```mathplot code fences into <MathPlot> components for MDX and react-markdown.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerarldlee/mathplot.git",
    "directory": "packages/remark"
  },
  "homepage": "https://gerarldlee.github.io/mathplot/",
  "bugs": {
    "url": "https://github.com/gerarldlee/mathplot/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --sourcemap --clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "prepack": "npm run build"
  },
  "dependencies": {
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}
