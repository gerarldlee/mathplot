{
  "name": "@mathplot/web-components",
  "version": "0.1.0",
  "description": "Custom elements for mathplot: <mathplot-plot>, <mathplot-2d>, <mathplot-3d>, <mathplot-heatmap>, <mathplot-bar>, <mathplot-line>, <mathplot-pie> for non-React sites.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles": {
      "import": "./dist/web-styles.js",
      "require": "./dist/web-styles.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx src/web-styles.ts --format esm,cjs --sourcemap --clean && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@mathplot/core": "0.1.0",
    "@mathplot/react": "0.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^30.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.1"
  }
}